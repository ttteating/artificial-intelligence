# ===== 真实 LLM 通路（可选）=====
# 复制本文件为 .env 后填写；.env 已被 .gitignore 排除，不会提交。
# 读取优先级：进程环境变量 > .env > 代码默认值。

# 必填：API key（留空则 A2/M1/H 自动回退 mock，解释回退模板）
LLM_API_KEY=

# 可选：OpenAI 兼容网关。用 OpenAI 官方时留空即可。
# 例：DeepSeek  https://api.deepseek.com/v1
#     Moonshot  https://api.moonshot.cn/v1
# LLM_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名，默认 gpt-4o-mini
# LLM_MODEL=gpt-4o-mini
